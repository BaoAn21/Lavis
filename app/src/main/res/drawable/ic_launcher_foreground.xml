<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon FOREGROUND layer: a beamed eighth-note in terminal green (#33FF66).
  The whole glyph is kept within the center ~66dp "safe zone" (radius ~33 around 54,54)
  so launcher masks never clip it. A soft radial glow behind it gives the CRT look.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft green glow disc behind the note (fades to transparent at the edge). -->
    <path android:pathData="M20,52a34,34 0 1,0 68,0a34,34 0 1,0 -68,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="52"
                android:gradientRadius="34">
                <item android:offset="0.0" android:color="#5533FF66" />
                <item android:offset="1.0" android:color="#0033FF66" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
      The note itself, drawn as one filled path with sub-shapes:
      beam (top bar), two stems, and two round note-heads (stems-up, heads bottom-left).
    -->
    <path
        android:fillColor="#33FF66"
        android:fillType="nonZero"
        android:pathData="M38,29L72,29L72,38L38,38Z
                          M38,36L41.5,36L41.5,70L38,70Z
                          M68.5,36L72,36L72,64L68.5,64Z
                          M26.5,70a7.5,7.5 0 1,0 15,0a7.5,7.5 0 1,0 -15,0Z
                          M56.5,64a7.5,7.5 0 1,0 15,0a7.5,7.5 0 1,0 -15,0Z" />
</vector>
