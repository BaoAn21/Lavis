<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon BACKGROUND layer.
  Full-bleed 108x108 so it fills whatever mask the launcher applies (circle, squircle...).
  A near-black terminal gradient (top slightly lighter) to match the app's CRT palette.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0L108,0L108,108L0,108Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0.0" android:color="#FF121712" />
                <item android:offset="1.0" android:color="#FF080A08" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
